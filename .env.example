# TrustShield Environment Variables
# Copy this file to .env and fill in any optional values

# ─── Optional: Threat Intelligence Providers ───────────────────────────────────
# Google Safe Browsing API (optional — not required for local operation)
# GOOGLE_SAFE_BROWSING_API_KEY=your_key_here

# PhishTank API (optional)
# PHISHTANK_APP_KEY=your_key_here

# URLhaus (optional)
# URLHAUS_API_KEY=your_key_here

# ─── API Configuration ────────────────────────────────────────────────────────
# TRUSTSHIELD_HOST=0.0.0.0
# TRUSTSHIELD_PORT=8000

# ─── Model Configuration ──────────────────────────────────────────────────────
# MODEL_ARTIFACTS_DIR=backend/ml/model_artifacts

# ─── Notes ────────────────────────────────────────────────────────────────────
# Never commit the real .env file to git.
# The application runs fully locally without any API keys.
# All threat intelligence integrations are optional enhancements.
